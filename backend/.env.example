# ── Required ─────────────────────────────────────────────
# MongoDB connection string (local, or a free MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/behavioral-twin

# Long random string used to sign login tokens (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── AI (Google Gemini — free key from https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Optional ─────────────────────────────────────────────
# PORT=5000
# NODE_ENV=production
# JWT_EXPIRES_IN=7d
# Default timezone for new users (IANA name)
# DEFAULT_TIMEZONE=Asia/Kolkata
# Set to false to disable the background jobs (e.g. on a second instance)
# ENABLE_CRON=true

# Only needed when the frontend runs on a different origin than the API
# (local dev with `npm start` in frontend/ uses the CRA proxy, so leave empty).
# FRONTEND_URL=http://localhost:3000

# Public URL of this backend — used to build the Google OAuth callback URL
# BACKEND_URL=http://localhost:5000

# ── Google Fit sync (optional) ───────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Defaults to ${BACKEND_URL}/api/google/callback
# GOOGLE_REDIRECT_URI=
