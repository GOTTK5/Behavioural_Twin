# ── Required ─────────────────────────────────────────────
# MongoDB connection string (local, or a free MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/behavioral-twin

# Long random string used to sign login tokens (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── AI (Google Gemini — free key from https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-flash-latest   (if it is unavailable, the app picks a working model itself)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Email for "Forgot password" (Brevo — free 300 emails/day, https://www.brevo.com) ──
# Brevo → SMTP & API → API Keys → Generate a new API key
# BREVO_API_KEY=
# Sender address you verified in Brevo → Senders, Domains & Dedicated IPs → Senders
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=Twin
# Public URL of the website, used in emailed links (Render sets RENDER_EXTERNAL_URL automatically)
# APP_URL=https://your-app.onrender.com
# Without Brevo, in development the reset link is printed in the backend console.

# ── Optional ─────────────────────────────────────────────
# PORT=5000
# NODE_ENV=production
# JWT_EXPIRES_IN=7d
# Default timezone for new users (IANA name)
# DEFAULT_TIMEZONE=Asia/Kolkata
# Set to false to disable the background jobs (e.g. on a second instance)
# ENABLE_CRON=true

# Only needed when the frontend runs on a different origin than the API
# (local dev with `npm start` in frontend/ uses the CRA proxy, so leave empty).
# FRONTEND_URL=http://localhost:3000
